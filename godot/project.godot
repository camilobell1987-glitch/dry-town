; Engine configuration file.
; Open this folder in Godot 4 (.NET edition) to run the game.

config_version=5

[application]

config/name="Dry Town"
config/description="Open-ended Prohibition-era crime strategy. Phase 1 rules prototype."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[dotnet]

project/assembly_name="DryTown"
